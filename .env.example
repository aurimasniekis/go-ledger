# Ledger environment variables.
# Generated from the configuration definition by "ledger config env"; do not
# edit by hand. Regenerate with: make config-examples
#
# Copy this file to .env for local development. A real environment variable
# always wins over .env. Every line below is commented out and shows the
# built-in default: uncomment a line to override it. Precedence, highest first:
# command-line flags, environment variables, the YAML file, defaults.
# Lists are comma separated, durations look like 30s. Never commit a real
# secret.

# Path of the YAML config file. The --config flag wins. A missing file is
# allowed when the environment supplies every required value.
# Type: string. Not a YAML key. Flag: --config.
# LEDGER_CONFIG=

# Path of the .env file to load before configuration is parsed. A missing file
# is not an error. Only effective in the real environment, not inside a .env
# file.
# Type: string. Default: .env. Not a YAML key.
# LEDGER_ENV_FILE=.env

# Address the HTTP server listens on, as host:port. The default accepts local
# connections only; use :8080 to listen on every interface.
# Type: string. Default: 127.0.0.1:8080. YAML key: http.listen. Flag:
# --http.listen.
# LEDGER_HTTP_LISTEN=127.0.0.1:8080

# Maximum time to read a request's headers.
# Type: duration. Default: 10s. YAML key: http.read_header_timeout. Flag:
# --http.read_header_timeout.
# LEDGER_HTTP_READ_HEADER_TIMEOUT=10s

# Maximum time to read an entire request, body included.
# Type: duration. Default: 30s. YAML key: http.read_timeout. Flag:
# --http.read_timeout.
# LEDGER_HTTP_READ_TIMEOUT=30s

# Maximum time to write a response.
# Type: duration. Default: 60s. YAML key: http.write_timeout. Flag:
# --http.write_timeout.
# LEDGER_HTTP_WRITE_TIMEOUT=60s

# Maximum time an idle keep-alive connection stays open.
# Type: duration. Default: 120s. YAML key: http.idle_timeout. Flag:
# --http.idle_timeout.
# LEDGER_HTTP_IDLE_TIMEOUT=120s

# How long graceful shutdown waits for in-flight requests before closing
# connections.
# Type: duration. Default: 15s. YAML key: http.shutdown_timeout. Flag:
# --http.shutdown_timeout.
# LEDGER_HTTP_SHUTDOWN_TIMEOUT=15s

# Maximum size of a request body in bytes.
# Type: integer. Default: 1048576. YAML key: http.max_body_bytes. Flag:
# --http.max_body_bytes.
# LEDGER_HTTP_MAX_BODY_BYTES=1048576

# Address of the management listener that serves /metrics, /healthz and
# /readyz, as host:port. Unauthenticated by design: keep it on loopback or a
# private network, never a public interface. Empty (set in the YAML file or
# with --http.management_listen=; a blank environment variable counts as
# unset) serves them on the main listener instead.
# Type: string. Default: 127.0.0.1:9090. YAML key: http.management_listen.
# Flag: --http.management_listen.
# LEDGER_HTTP_MANAGEMENT_LISTEN=127.0.0.1:9090

# IP addresses or CIDR ranges of reverse proxies whose forwarding headers are
# trusted (a list in YAML, comma separated in the variable). Empty trusts
# none. Behind a reverse proxy, list it here: otherwise every client has the
# proxy's address, and the per-address sign-in limit becomes one lockout
# shared by everyone, the owner included (ADR-0026). Ledger logs a warning
# when X-Forwarded-For arrives from an untrusted loopback or private address.
# Type: list. YAML key: http.trusted_proxies. Flag: --http.trusted_proxies.
# LEDGER_HTTP_TRUSTED_PROXIES=

# Path of the SQLite database file. The directory is created if it is missing.
# Type: string. Default: data/ledger.db. YAML key: database.path. Flag:
# --database.path.
# LEDGER_DATABASE_PATH=data/ledger.db

# How long a statement waits for a locked database before failing.
# Type: duration. Default: 5s. YAML key: database.busy_timeout. Flag:
# --database.busy_timeout.
# LEDGER_DATABASE_BUSY_TIMEOUT=5s

# Minimum log level.
# Type: string. Default: info. YAML key: log.level. Flag: --log.level.
# LEDGER_LOG_LEVEL=info

# Log output format: json for machines, text for people.
# Type: string. Default: json. YAML key: log.format. Flag: --log.format.
# LEDGER_LOG_FORMAT=json

# IANA time zone used for due dates and monthly views, for example
# Europe/Vilnius. Empty means the zone stored in the database; on first start
# against a new database the host's IANA zone is captured once and stored, and
# startup is refused if the host has no IANA name. A value that differs from
# the stored zone is applied with a warning, because it reclassifies dates;
# its audit entry is recorded once the audit log exists. 'Local' is not
# accepted.
# Type: string. YAML key: reporting.timezone. Flag: --reporting.timezone.
# LEDGER_REPORTING_TIMEZONE=

# ISO 4217 code of the reporting currency, for example EUR: the outlook adds a
# secondary total converted into it, next to the per-currency figures,
# counting only amounts with an acceptable exchange rate and listing the rest
# as excluded (decision D5). Empty means no converted total unless a request
# asks for one.
# Type: string. YAML key: reporting.currency. Flag: --reporting.currency.
# LEDGER_REPORTING_CURRENCY=

# Key-encryption key for stored credentials (TOTP secrets are encrypted with a
# key derived from it). Use a long random value, for example 32 random bytes
# in base64. Changing it makes enrolled authenticators unusable: users then
# sign in with a recovery code, or the host resets their two-factor
# authentication. Required unless LEDGER_KEK_FILE is set. Secret: environment
# only, never in the YAML file and never a flag.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# kek.value.
# LEDGER_KEK_VALUE=

# Path of a file that contains the key-encryption key. Alternative to
# LEDGER_KEK_VALUE; trailing newlines are ignored.
# Type: string. YAML key: kek.file. Flag: --kek.file.
# LEDGER_KEK_FILE=

# Publish events to Pulse. Off by default. While off, nothing is recorded or
# published, and turning it on later does not replay changes made while it was
# off.
# Type: boolean. Default: false. YAML key: events.pulse.enabled. Flag:
# --events.pulse.enabled.
# LEDGER_EVENTS_PULSE_ENABLED=false

# Event source stamped on every published event (the envelope's source field):
# 1 to 128 printable characters.
# Type: string. Default: ledger. YAML key: events.pulse.source. Flag:
# --events.pulse.source.
# LEDGER_EVENTS_PULSE_SOURCE=ledger

# Pulse server URL; must use the tls:// scheme, for example
# tls://pulse.example.com:4222. Required when events.pulse.enabled is true.
# Nothing connects while publishing is off.
# Type: string. YAML key: events.pulse.url. Flag: --events.pulse.url.
# LEDGER_EVENTS_PULSE_URL=

# Path of the Pulse .creds file (user JWT and key seed). Required when
# events.pulse.enabled is true. Only the path is configuration: the file is
# read by the Pulse client, never copied, and its path and content are never
# logged.
# Type: string. YAML key: events.pulse.creds_file. Flag:
# --events.pulse.creds_file.
# LEDGER_EVENTS_PULSE_CREDS_FILE=

# Optional PEM file with an extra CA to trust for the Pulse server, added to
# the system roots. Certificate verification is never disabled.
# Type: string. YAML key: events.pulse.ca_file. Flag: --events.pulse.ca_file.
# LEDGER_EVENTS_PULSE_CA_FILE=

# Connection name shown on the Pulse server.
# Type: string. Default: ledger. YAML key: events.pulse.name. Flag:
# --events.pulse.name.
# LEDGER_EVENTS_PULSE_NAME=ledger

# Where a bank sends you back after you approve access: Ledger's external
# address followed by /connections/callback, for example
# https://ledger.example.com/connections/callback. The same URL must be
# registered with the banking provider. https only (plain http only on
# loopback). Empty means connecting a bank (and reconnecting) is switched off;
# refreshing and disconnecting existing connections still work.
# Type: string. YAML key: banking.redirect_url. Flag: --banking.redirect_url.
# LEDGER_BANKING_REDIRECT_URL=

# How long a started bank consent may wait for the bank's redirect. After it a
# completion is refused (409 consent_not_found) and a connection that never
# connected becomes failed (consent_expired). Between 1 minute and 24 hours.
# Type: duration. Default: 1h. YAML key: banking.consent_ttl. Flag:
# --banking.consent_ttl.
# LEDGER_BANKING_CONSENT_TTL=1h

# How old the last successful refresh of a bank account may be before its data
# is shown as stale (and the background scheduler refreshes it). Between 1
# minute and 30 days.
# Type: duration. Default: 24h. YAML key: banking.stale_after. Flag:
# --banking.stale_after.
# LEDGER_BANKING_STALE_AFTER=24h

# Enable Banking API base URL. Sandbox and production applications use the
# same host; the environment belongs to the application.
# Type: string. Default: https://api.enablebanking.com. YAML key:
# banking.enable_banking.base_url. Flag: --banking.enable_banking.base_url.
# LEDGER_BANKING_ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# Configure the Enable Banking application for this mode. app mode means an
# unrestricted production application (signed contract with Enable Banking).
# developer mode means a restricted production application that reaches only
# the accounts linked to it in the Enable Banking Control Panel. Neither mode
# is the sandbox.
# Type: boolean. Default: false. YAML key: banking.enable_banking.app.enabled.
# Flag: --banking.enable_banking.app.enabled.
# LEDGER_BANKING_ENABLE_BANKING_APP_ENABLED=false

# Ledger's name for this application, recorded on every connection made with
# it: 1 to 64 lower-case letters, digits, '-' or '_'. Empty means
# enablebanking-app or enablebanking-developer. Changing it orphans existing
# connections.
# Type: string. YAML key: banking.enable_banking.app.name. Flag:
# --banking.enable_banking.app.name.
# LEDGER_BANKING_ENABLE_BANKING_APP_NAME=

# Application id from the Enable Banking Control Panel (a UUID, sent as the
# JWT kid). Required when the application is enabled. Never logged.
# Type: string. YAML key: banking.enable_banking.app.app_id. Flag:
# --banking.enable_banking.app.app_id.
# LEDGER_BANKING_ENABLE_BANKING_APP_APP_ID=

# Environment the application was registered in at Enable Banking. sandbox is
# for testing with simulated banks; it is not a mode.
# Type: string. Default: production. YAML key:
# banking.enable_banking.app.environment. Flag:
# --banking.enable_banking.app.environment.
# LEDGER_BANKING_ENABLE_BANKING_APP_ENVIRONMENT=production

# PEM-encoded RSA private key of the application (in .env, one double-quoted
# line with \n for line breaks). Secret: environment only, never in the YAML
# file and never a flag. Set this or private_key_file.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# banking.enable_banking.app.private_key.
# LEDGER_BANKING_ENABLE_BANKING_APP_PRIVATE_KEY=

# Path of the PEM-encoded RSA private key file of the application. Alternative
# to the private_key variable. Only the path is configuration; the key is
# never logged.
# Type: string. YAML key: banking.enable_banking.app.private_key_file. Flag:
# --banking.enable_banking.app.private_key_file.
# LEDGER_BANKING_ENABLE_BANKING_APP_PRIVATE_KEY_FILE=

# Configure the Enable Banking application for this mode. app mode means an
# unrestricted production application (signed contract with Enable Banking).
# developer mode means a restricted production application that reaches only
# the accounts linked to it in the Enable Banking Control Panel. Neither mode
# is the sandbox.
# Type: boolean. Default: false. YAML key:
# banking.enable_banking.developer.enabled. Flag:
# --banking.enable_banking.developer.enabled.
# LEDGER_BANKING_ENABLE_BANKING_DEVELOPER_ENABLED=false

# Ledger's name for this application, recorded on every connection made with
# it: 1 to 64 lower-case letters, digits, '-' or '_'. Empty means
# enablebanking-app or enablebanking-developer. Changing it orphans existing
# connections.
# Type: string. YAML key: banking.enable_banking.developer.name. Flag:
# --banking.enable_banking.developer.name.
# LEDGER_BANKING_ENABLE_BANKING_DEVELOPER_NAME=

# Application id from the Enable Banking Control Panel (a UUID, sent as the
# JWT kid). Required when the application is enabled. Never logged.
# Type: string. YAML key: banking.enable_banking.developer.app_id. Flag:
# --banking.enable_banking.developer.app_id.
# LEDGER_BANKING_ENABLE_BANKING_DEVELOPER_APP_ID=

# Environment the application was registered in at Enable Banking. sandbox is
# for testing with simulated banks; it is not a mode.
# Type: string. Default: production. YAML key:
# banking.enable_banking.developer.environment. Flag:
# --banking.enable_banking.developer.environment.
# LEDGER_BANKING_ENABLE_BANKING_DEVELOPER_ENVIRONMENT=production

# PEM-encoded RSA private key of the application (in .env, one double-quoted
# line with \n for line breaks). Secret: environment only, never in the YAML
# file and never a flag. Set this or private_key_file.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# banking.enable_banking.developer.private_key.
# LEDGER_BANKING_ENABLE_BANKING_DEVELOPER_PRIVATE_KEY=

# Path of the PEM-encoded RSA private key file of the application. Alternative
# to the private_key variable. Only the path is configuration; the key is
# never logged.
# Type: string. YAML key: banking.enable_banking.developer.private_key_file.
# Flag: --banking.enable_banking.developer.private_key_file.
# LEDGER_BANKING_ENABLE_BANKING_DEVELOPER_PRIVATE_KEY_FILE=

# Refresh active bank connections in the background. When false, connections
# are only refreshed on request. Retries of one read and the provider's daily
# fetch budget are not configurable.
# Type: boolean. Default: true. YAML key: banking.refresh.enabled. Flag:
# --banking.refresh.enabled.
# LEDGER_BANKING_REFRESH_ENABLED=true

# Time between successful background refreshes of a connection. Banks commonly
# allow about four background fetches a day; the scheduler also keeps to the
# provider's daily budget whatever this is set to.
# Type: duration. Default: 6h. YAML key: banking.refresh.interval. Flag:
# --banking.refresh.interval.
# LEDGER_BANKING_REFRESH_INTERVAL=6h

# How long after a refresh of a bank connection finished (whoever started it,
# whatever the outcome) another refresh on request for that connection is
# refused with HTTP 429 and Retry-After. It applies to the API, the web UI,
# the CLI and MCP; the background refresh is not held back. 0s switches it
# off; at most 24h (decision D-B6c).
# Type: duration. Default: 5m. YAML key: banking.refresh.request_cooldown.
# Flag: --banking.refresh.request_cooldown.
# LEDGER_BANKING_REFRESH_REQUEST_COOLDOWN=5m

# Longest wait after failed refreshes. The wait starts at 15 minutes and
# doubles per consecutive failure. A rate limit waits at least 6 hours, or the
# provider's Retry-After (at most 24 hours).
# Type: duration. Default: 6h. YAML key: banking.refresh.max_backoff. Flag:
# --banking.refresh.max_backoff.
# LEDGER_BANKING_REFRESH_MAX_BACKOFF=6h

# Fetch exchange rates from Frankfurter (https://frankfurter.dev, free, no
# key) and cache them locally. Off by default: the outlook then shows only
# amounts already in the reporting currency and lists the rest as excluded
# (no_provider), though rates cached while it was on are still used and shown
# with their age. Turning it on sends currency codes (never amounts or account
# data) to the Frankfurter service.
# Type: boolean. Default: false. YAML key: rates.enabled. Flag:
# --rates.enabled.
# LEDGER_RATES_ENABLED=false

# Frankfurter base URL. https only (plain http only for a loopback test
# server).
# Type: string. Default: https://api.frankfurter.dev. YAML key:
# rates.base_url. Flag: --rates.base_url.
# LEDGER_RATES_BASE_URL=https://api.frankfurter.dev

# Frankfurter provider key whose rates are used, for example ECB (European
# Central Bank reference rates, published on working days; a weekend or
# holiday uses the previous working day), or blended for Frankfurter's own
# blend of its providers. Rates of different sources are cached apart and
# never mixed; changing this stops using the rates of the old source.
# Type: string. Default: ECB. YAML key: rates.source. Flag: --rates.source.
# LEDGER_RATES_SOURCE=ECB

# Time between background refreshes of the rates from every currency in use to
# the reporting currency (decision D11: daily), and how long a cached rate is
# used without asking Frankfurter again. 1h to the stale_after value. Needs
# reporting.currency; without it nothing is refreshed in the background.
# Type: duration. Default: 24h. YAML key: rates.refresh_interval. Flag:
# --rates.refresh_interval.
# LEDGER_RATES_REFRESH_INTERVAL=24h

# How old a cached rate may get before it is treated as stale and left out of
# converted totals (decision D11: 5 days): measured from when it was last
# retrieved, and from its date to the date it is used for. 24h or more.
# Type: duration. Default: 120h. YAML key: rates.stale_after. Flag:
# --rates.stale_after.
# LEDGER_RATES_STALE_AFTER=120h

# Time limit for one request to Frankfurter (1s to 2m). A request that exceeds
# it counts as an outage: cached rates stay in use.
# Type: duration. Default: 15s. YAML key: rates.timeout. Flag:
# --rates.timeout.
# LEDGER_RATES_TIMEOUT=15s

# Ask a remote merchant-identification service about transactions the local
# curated mapping and your confirmations cannot identify. Off by default and
# no service is approved (decision D15). Turning it on sends one cleaned
# merchant string per transaction: the counterparty name only, never the
# description, with every word that holds a digit removed and the words iban,
# bic, swift and account removed (text is split at white space and at , / .
# and ;), at most 100 characters. Nothing is sent unless the name starts or
# ends, as a whole word in any case, with one of the company forms uab, mb,
# sia, ltd, limited, llc, gmbh, inc, plc, corp, srl, sarl, kft, oü next to at
# least one other word. The short forms as, co, sa, ab, ag, sp, oy, nv and bv
# never count, a bare form or a form plus punctuation sends nothing, and so do
# names of people, transfers (transfer words such as sepa or transfer) and
# everything else. Merchants your own confirmations or rejections already
# cover are not asked about. If merchants.enrichment.remote.country is set,
# that country code is sent too. Never amounts, dates, IBANs, account holders
# or balances. Needs url, and you are responsible for the service's terms: see
# attribution, store_logo_ref and retention.
# Type: boolean. Default: false. YAML key:
# merchants.enrichment.remote.enabled. Flag:
# --merchants.enrichment.remote.enabled.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_ENABLED=false

# Lookup endpoint of the remote service (POST, JSON; see ADR-0054 for the
# contract). https only (plain http only for a loopback test server), no
# credentials or query. Required when enabled.
# Type: string. YAML key: merchants.enrichment.remote.url. Flag:
# --merchants.enrichment.remote.url.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_URL=

# Path of a file with the bearer key for the remote service (trailing newlines
# ignored). The key is read at startup, sent only to the configured URL and
# never logged. Optional.
# Type: string. YAML key: merchants.enrichment.remote.api_key_file. Flag:
# --merchants.enrichment.remote.api_key_file.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_API_KEY_FILE=

# Optional ISO 3166-1 alpha-2 country code sent with each lookup as a hint,
# for example LT. Empty means no country is sent.
# Type: string. YAML key: merchants.enrichment.remote.country. Flag:
# --merchants.enrichment.remote.country.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_COUNTRY=

# Time limit for one lookup (1s to 1m). A failure or timeout leaves the
# transaction without a remote answer and never delays or fails an import.
# Type: duration. Default: 10s. YAML key: merchants.enrichment.remote.timeout.
# Flag: --merchants.enrichment.remote.timeout.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_TIMEOUT=10s

# Attribution text the service's licence requires, for example 'Logos by
# Example Service'. Shown with identities that came from it (GET
# /api/v1/merchants/sources). Up to 200 characters.
# Type: string. YAML key: merchants.enrichment.remote.attribution. Flag:
# --merchants.enrichment.remote.attribution.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_ATTRIBUTION=

# Keep the logo reference the service returns. Leave false unless its licence
# allows storing or linking its logos: Ledger then shows the name with a
# neutral icon. Logos are never downloaded or copied by Ledger.
# Type: boolean. Default: false. YAML key:
# merchants.enrichment.remote.store_logo_ref. Flag:
# --merchants.enrichment.remote.store_logo_ref.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_STORE_LOGO_REF=false

# How long answers from the remote service are kept (the longest a licence
# usually allows is 30 days, the default; 24h to 8760h, or 0 to keep them
# until replaced). Older answers are deleted, so the transaction is looked up
# again; your confirmations and corrections are never deleted. The limit still
# applies after the remote source is turned off: answers it cached are deleted
# when they pass it (0 keeps them until replaced, which never happens once it
# is off).
# Type: duration. Default: 720h. YAML key:
# merchants.enrichment.remote.retention. Flag:
# --merchants.enrichment.remote.retention.
# LEDGER_MERCHANTS_ENRICHMENT_REMOTE_RETENTION=720h

# Allow signing in with a username and password. false refuses password
# sign-in and password re-authentication for everyone (403
# password_sign_in_disabled) and sends the sign-in page to single sign-on; it
# needs auth.oidc.enabled. Linking an OIDC identity never turns password
# sign-in off by itself. If the identity provider is unavailable while this is
# false, the host can issue a one-time sign-in with ledger auth
# recovery-sign-in (docs/oidc.md).
# Type: boolean. Default: true. YAML key: auth.password.enabled. Flag:
# --auth.password.enabled.
# LEDGER_AUTH_PASSWORD_ENABLED=true

# Minimum password length in bytes (1 to 1024). Length is the only rule: there
# are no composition rules.
# Type: integer. Default: 12. YAML key: auth.password.min_length. Flag:
# --auth.password.min_length.
# LEDGER_AUTH_PASSWORD_MIN_LENGTH=12

# A session not used for this long ends. Must not exceed the absolute timeout.
# Type: duration. Default: 30m. YAML key: auth.session.idle_timeout. Flag:
# --auth.session.idle_timeout.
# LEDGER_AUTH_SESSION_IDLE_TIMEOUT=30m

# A session ends this long after sign-in, however much it is used.
# Type: duration. Default: 12h. YAML key: auth.session.absolute_timeout. Flag:
# --auth.session.absolute_timeout.
# LEDGER_AUTH_SESSION_ABSOLUTE_TIMEOUT=12h

# How long a password check counts as recent for sensitive actions (credential
# changes, token creation, user management). After it, the user confirms their
# password again.
# Type: duration. Default: 10m. YAML key: auth.session.reauth_window. Flag:
# --auth.session.reauth_window.
# LEDGER_AUTH_SESSION_REAUTH_WINDOW=10m

# Failed sign-ins (and re-authentications) allowed per username within
# auth.sign_in.window before further attempts for it are refused with 429.
# Type: integer. Default: 10. YAML key: auth.sign_in.account_max_failures.
# Flag: --auth.sign_in.account_max_failures.
# LEDGER_AUTH_SIGN_IN_ACCOUNT_MAX_FAILURES=10

# Failed sign-ins allowed per client address (an IPv6 address counts as its
# /64) within auth.sign_in.window before further attempts from it are refused
# with 429.
# Type: integer. Default: 30. YAML key: auth.sign_in.address_max_failures.
# Flag: --auth.sign_in.address_max_failures.
# LEDGER_AUTH_SIGN_IN_ADDRESS_MAX_FAILURES=30

# Sliding window over which failed sign-ins are counted.
# Type: duration. Default: 15m. YAML key: auth.sign_in.window. Flag:
# --auth.sign_in.window.
# LEDGER_AUTH_SIGN_IN_WINDOW=15m

# Lifetime of the device cookie a browser gets at each complete password
# sign-in (decision D23-1b). While it is valid, that browser's failed sign-ins
# count against the cookie instead of the username, so a username locked out
# by someone else's guesses does not lock out the owner's known browsers; the
# per-address limit, the password and the second factor still apply. Changing
# a user's password revokes all of that user's device cookies. Default 2160h
# (90 days), accepted by the operator (D30, 2026-11-21).
# Type: duration. Default: 2160h. YAML key: auth.sign_in.device_cookie_ttl.
# Flag: --auth.sign_in.device_cookie_ttl.
# LEDGER_AUTH_SIGN_IN_DEVICE_COOKIE_TTL=2160h

# Allow signing in with one OpenID Connect identity provider (authorization
# code flow with PKCE). Users link their identity while signed in; an identity
# that is not linked gets no access unless auth.oidc.provisioning.enabled is
# true.
# Type: boolean. Default: false. YAML key: auth.oidc.enabled. Flag:
# --auth.oidc.enabled.
# LEDGER_AUTH_OIDC_ENABLED=false

# Name of the identity provider shown on the sign-in page and recorded in
# audit entries: 1 to 64 printable characters.
# Type: string. Default: Single sign-on. YAML key: auth.oidc.name. Flag:
# --auth.oidc.name.
# LEDGER_AUTH_OIDC_NAME=Single sign-on

# Issuer URL of the provider, exactly as its discovery document states it (a
# trailing slash matters), for example https://id.example.com/realms/home.
# https only (plain http only for a loopback test provider). Links are keyed
# by issuer and subject: changing the issuer leaves every existing link
# unusable.
# Type: string. YAML key: auth.oidc.issuer. Flag: --auth.oidc.issuer.
# LEDGER_AUTH_OIDC_ISSUER=

# Client ID registered for Ledger at the provider. Required when
# auth.oidc.enabled is true.
# Type: string. YAML key: auth.oidc.client_id. Flag: --auth.oidc.client_id.
# LEDGER_AUTH_OIDC_CLIENT_ID=

# Client secret registered for Ledger at the provider. Secret: environment
# only, never in the YAML file and never a flag. Set this or
# client_secret_file.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# auth.oidc.client_secret.
# LEDGER_AUTH_OIDC_CLIENT_SECRET=

# Path of a file that contains the client secret. Alternative to the
# client_secret variable; trailing newlines are ignored. Only the path is
# configuration; the secret is never logged.
# Type: string. YAML key: auth.oidc.client_secret_file. Flag:
# --auth.oidc.client_secret_file.
# LEDGER_AUTH_OIDC_CLIENT_SECRET_FILE=

# Callback URL registered at the provider: Ledger's external address followed
# by /api/v1/auth/oidc/callback, for example
# https://ledger.example.com/api/v1/auth/oidc/callback. https only (plain http
# only on loopback).
# Type: string. YAML key: auth.oidc.redirect_url. Flag:
# --auth.oidc.redirect_url.
# LEDGER_AUTH_OIDC_REDIRECT_URL=

# Scopes requested (a list in YAML, comma separated in the variable). Must
# include openid. email and profile only fill in display data and a
# provisioned account's username; identity is never taken from them.
# Type: list. Default: openid,email,profile. YAML key: auth.oidc.scopes. Flag:
# --auth.oidc.scopes.
# LEDGER_AUTH_OIDC_SCOPES=openid,email,profile

# Ask users who have Ledger TOTP enabled for their code after an OIDC sign-in
# too, and apply auth.require_2fa to OIDC sessions. false (the default,
# decision D16) trusts the identity provider's own authentication.
# Type: boolean. Default: false. YAML key: auth.oidc.require_2fa. Flag:
# --auth.oidc.require_2fa.
# LEDGER_AUTH_OIDC_REQUIRE_2FA=false

# Clock difference tolerated when checking ID token times (exp, nbf, iat,
# auth_time): 0 to 5m.
# Type: duration. Default: 1m. YAML key: auth.oidc.clock_skew. Flag:
# --auth.oidc.clock_skew.
# LEDGER_AUTH_OIDC_CLOCK_SKEW=1m

# Create an account, with no password, the first time an identity that is
# linked to no account signs in, and link it. Off by default: unknown
# identities are refused. Accounts are never matched by email address.
# Type: boolean. Default: false. YAML key: auth.oidc.provisioning.enabled.
# Flag: --auth.oidc.provisioning.enabled.
# LEDGER_AUTH_OIDC_PROVISIONING_ENABLED=false

# Role of accounts created by provisioning.
# Type: string. Default: read-only. YAML key: auth.oidc.provisioning.role.
# Flag: --auth.oidc.provisioning.role.
# LEDGER_AUTH_OIDC_PROVISIONING_ROLE=read-only

# Require two-factor authentication (TOTP) for everyone. A signed-in user
# without it can only enrol an authenticator, see their session,
# re-authenticate and sign out; every other request is refused with 403
# two_factor_enrollment_required. API tokens are not affected. While it is on,
# users cannot disable their own TOTP (the host command ledger auth reset-2fa
# can).
# Type: boolean. Default: false. YAML key: auth.require_2fa. Flag:
# --auth.require_2fa.
# LEDGER_AUTH_REQUIRE_2FA=false

# Serve the MCP endpoint (streamable HTTP, POST /api/v1/mcp). Every call needs
# an API token and is limited to what the token's grants allow, exactly as
# through the HTTP API. false removes the endpoint (404). The stdio mode
# (ledger mcp stdio) is a separate client-side command and is not affected.
# Type: boolean. Default: true. YAML key: mcp.enabled. Flag: --mcp.enabled.
# LEDGER_MCP_ENABLED=true

# Sustained MCP requests allowed per API token per minute (1 to 100000); more
# are refused with 429 rate_limited and Retry-After. Counted in memory per
# process, reset on restart.
# Type: integer. Default: 120. YAML key: mcp.requests_per_minute. Flag:
# --mcp.requests_per_minute.
# LEDGER_MCP_REQUESTS_PER_MINUTE=120

# Most MCP requests one API token may send at once before the per-minute rate
# applies (1 to 10000).
# Type: integer. Default: 30. YAML key: mcp.burst. Flag: --mcp.burst.
# LEDGER_MCP_BURST=30

# Maximum size of one MCP request body in bytes (1024 to 16777216); larger
# bodies are refused with 413. The general http.max_body_bytes applies as
# well.
# Type: integer. Default: 262144. YAML key: mcp.max_request_bytes. Flag:
# --mcp.max_request_bytes.
# LEDGER_MCP_MAX_REQUEST_BYTES=262144

# OpenRouter API key. Secret: environment only, never in the YAML file and
# never a flag. Set this or api_key_file. Required when an enabled decision
# task (or its fallback) uses OpenRouter.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# decisions.providers.openrouter.api_key.
# LEDGER_DECISIONS_PROVIDERS_OPENROUTER_API_KEY=

# Path of a file that contains the OpenRouter API key. Alternative to the
# api_key variable; trailing newlines are ignored.
# Type: string. YAML key: decisions.providers.openrouter.api_key_file. Flag:
# --decisions.providers.openrouter.api_key_file.
# LEDGER_DECISIONS_PROVIDERS_OPENROUTER_API_KEY_FILE=

# Upstream providers OpenRouter may forward Ledger's requests to (a list in
# YAML, comma separated in the variable), for example anthropic. Empty (the
# default) means downstream sharing is disabled and no task may use OpenRouter
# (decision D13). Consent for another provider never covers an upstream
# reached through OpenRouter.
# Type: list. YAML key: decisions.providers.openrouter.allowed_upstreams.
# Flag: --decisions.providers.openrouter.allowed_upstreams.
# LEDGER_DECISIONS_PROVIDERS_OPENROUTER_ALLOWED_UPSTREAMS=

# API key of this decision provider. Secret: environment only, never in the
# YAML file and never a flag. Set this or api_key_file. Required when an
# enabled decision task (or its fallback) uses the provider; never logged or
# sent anywhere but to the provider.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# decisions.providers.openai.api_key.
# LEDGER_DECISIONS_PROVIDERS_OPENAI_API_KEY=

# Path of a file that contains the API key of this decision provider.
# Alternative to the api_key variable; trailing newlines are ignored. Only the
# path is configuration; the key is never logged.
# Type: string. YAML key: decisions.providers.openai.api_key_file. Flag:
# --decisions.providers.openai.api_key_file.
# LEDGER_DECISIONS_PROVIDERS_OPENAI_API_KEY_FILE=

# API key of this decision provider. Secret: environment only, never in the
# YAML file and never a flag. Set this or api_key_file. Required when an
# enabled decision task (or its fallback) uses the provider; never logged or
# sent anywhere but to the provider.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# decisions.providers.anthropic.api_key.
# LEDGER_DECISIONS_PROVIDERS_ANTHROPIC_API_KEY=

# Path of a file that contains the API key of this decision provider.
# Alternative to the api_key variable; trailing newlines are ignored. Only the
# path is configuration; the key is never logged.
# Type: string. YAML key: decisions.providers.anthropic.api_key_file. Flag:
# --decisions.providers.anthropic.api_key_file.
# LEDGER_DECISIONS_PROVIDERS_ANTHROPIC_API_KEY_FILE=

# API key of this decision provider. Secret: environment only, never in the
# YAML file and never a flag. Set this or api_key_file. Required when an
# enabled decision task (or its fallback) uses the provider; never logged or
# sent anywhere but to the provider.
# Type: string. SECRET: the value is never printed or logged. YAML key:
# decisions.providers.typesafe.api_key.
# LEDGER_DECISIONS_PROVIDERS_TYPESAFE_API_KEY=

# Path of a file that contains the API key of this decision provider.
# Alternative to the api_key variable; trailing newlines are ignored. Only the
# path is configuration; the key is never logged.
# Type: string. YAML key: decisions.providers.typesafe.api_key_file. Flag:
# --decisions.providers.typesafe.api_key_file.
# LEDGER_DECISIONS_PROVIDERS_TYPESAFE_API_KEY_FILE=

# Ask a decision provider for suggestions for this task. Off by default. Even
# when on, nothing is sent until consent for this provider and this purpose is
# recorded; consent for one provider or purpose never covers another.
# Suggestions are kept apart from bank facts and are only suggestions: a
# failure never changes anything.
# Type: boolean. Default: false. YAML key:
# decisions.tasks.categorisation.enabled. Flag:
# --decisions.tasks.categorisation.enabled.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_ENABLED=false

# Decision provider for this task: openrouter, openai, anthropic or typesafe.
# Required when the task is enabled. typesafe serves decide tasks only
# (categorisation, label_suggestion, payment_matching), not alerts.
# Type: string. YAML key: decisions.tasks.categorisation.provider. Flag:
# --decisions.tasks.categorisation.provider.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_PROVIDER=

# Model identifier at the provider. Required when the task is enabled. The
# model the provider reports is recorded with every suggestion.
# Type: string. YAML key: decisions.tasks.categorisation.model. Flag:
# --decisions.tasks.categorisation.model.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_MODEL=

# Capability the task needs: decide (a choice among candidates:
# categorisation, label_suggestion, payment_matching) or generate (free text:
# alerts). Empty means the task's own; any other value than the task's is
# refused.
# Type: string. YAML key: decisions.tasks.categorisation.capability. Flag:
# --decisions.tasks.categorisation.capability.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_CAPABILITY=

# Time limit for one run of the task on one provider, retries included (1s to
# 2m). A run that exceeds it ends without a suggestion and changes nothing.
# Type: duration. Default: 30s. YAML key:
# decisions.tasks.categorisation.timeout. Flag:
# --decisions.tasks.categorisation.timeout.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_TIMEOUT=30s

# Most requests the task may send per calendar month (UTC), every attempt
# counted, retries and fallback providers included (1 to 1000000). Once
# reached, the task makes no suggestions until the next month. The default of
# 500 is a proposal awaiting the operator.
# Type: integer. Default: 500. YAML key:
# decisions.tasks.categorisation.monthly_requests. Flag:
# --decisions.tasks.categorisation.monthly_requests.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_MONTHLY_REQUESTS=500

# Retries of a request the provider refused before generating anything (rate
# limit, overload: 0 to 2, decision D13), honouring Retry-After. A response
# that was generated, even a broken one, is never retried.
# Type: integer. Default: 2. YAML key: decisions.tasks.categorisation.retries.
# Flag: --decisions.tasks.categorisation.retries.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_RETRIES=2

# Mark suggestions for automatic application instead of review. Allowed for
# categorisation only (decision D13); an applied suggestion is always
# reversible and never replaces a person's choice.
# Type: boolean. Default: false. YAML key:
# decisions.tasks.categorisation.auto_apply. Flag:
# --decisions.tasks.categorisation.auto_apply.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_AUTO_APPLY=false

# Fields this task may send to its provider (a list in YAML, comma separated
# in the variable), from description, amount, currency, booking_date,
# merchant_name and candidate_names. Empty means the provider's default: all
# of them for openrouter, openai and anthropic (generate tasks have no
# candidates); description, merchant_name and candidate_names for typesafe.
# iban, account_number, counterparty_name and balance are never sent and are
# refused here. A decide task needs candidate_names. Applies to the main
# provider; fallback providers use their defaults.
# Type: list. YAML key: decisions.tasks.categorisation.fields. Flag:
# --decisions.tasks.categorisation.fields.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_FIELDS=

# Explicit fallback providers, as provider:model entries tried in order only
# when the one before had an outage (a list in YAML, comma separated in the
# variable). Empty (the default) means no fallback: there is never an
# automatic one. Each needs its own consent and key.
# Type: list. YAML key: decisions.tasks.categorisation.fallback. Flag:
# --decisions.tasks.categorisation.fallback.
# LEDGER_DECISIONS_TASKS_CATEGORISATION_FALLBACK=

# Ask a decision provider for suggestions for this task. Off by default. Even
# when on, nothing is sent until consent for this provider and this purpose is
# recorded; consent for one provider or purpose never covers another.
# Suggestions are kept apart from bank facts and are only suggestions: a
# failure never changes anything.
# Type: boolean. Default: false. YAML key:
# decisions.tasks.label_suggestion.enabled. Flag:
# --decisions.tasks.label_suggestion.enabled.
# LEDGER_DECISIONS_TASKS_LABEL_SUGGESTION_ENABLED=false

# Decision provider for this task: openrouter, openai, anthropic or typesafe.
# Required when the task is enabled. typesafe serves decide tasks only
# (categorisation, label_suggestion, payment_matching), not alerts.
# Type: string. YAML key: decisions.tasks.label_suggestion.provider. Flag:
