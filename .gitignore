# Build output
/bin/
/dist/
*.test
*.out
coverage.*

# Local configuration and secrets: never commit. .env.example is committed
# when configuration lands (F2).
.env
.env.*
!.env.example

# Local data and databases
/data/
*.db
*.db-shm
*.db-wal

# Editors and OS
.idea/
.vscode/
.DS_Store

# Frontend (F7): dependencies and test output. The production build lands in
# internal/web/dist; only its .gitkeep is tracked (ADR-0008).
node_modules/
web/playwright-report/
web/test-results/
/internal/web/dist/*
!/internal/web/dist/.gitkeep
